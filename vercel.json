{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/en/social",
      "destination": "/ru/social",
      "permanent": true
    },
    {
      "source": "/en/official-channels",
      "destination": "/ru/social",
      "permanent": true
    },
    {
      "source": "/social",
      "destination": "/ru/social",
      "permanent": true
    },
    {
      "source": "/ru/official-channels",
      "destination": "/ru/social",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ru/social",
      "destination": "/ru/social.html"
    },
    {
      "source": "/ru/social/",
      "destination": "/ru/social.html"
    },
    {
      "source": "/PucciPane",
      "destination": "/PucciPane/index.html"
    },
    {
      "source": "/PucciPane/(.*)",
      "destination": "/PucciPane/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
